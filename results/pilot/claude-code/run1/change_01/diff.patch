@@ -0,0 +1,56 @@
+"""API tests for the Notification service. Run against the live stack: `make up && make test-services`."""
+import os
+import uuid
+
+import httpx
+import pytest
+
+NOTIFICATION = os.environ.get("NOTIFICATION_URL", "http://localhost:8003")
+
+
+@pytest.fixture
+def client():
+    with httpx.Client(timeout=10) as c:
+        c.post(f"{NOTIFICATION}/admin/reset").raise_for_status()
+        yield c
+
+
+def send(client, order_id=None, recipient="ann@example.com", message="hello"):
+    return client.post(
+        f"{NOTIFICATION}/notifications",
+        json={"order_id": order_id or uuid.uuid4().hex, "recipient": recipient, "message": message},
+    )
+
+
+def test_store_and_list_by_order(client):
+    r = send(client, "o-1", "ann@example.com", "Order o-1 confirmed")
+    assert r.status_code == 201
+    send(client, "o-2")
+    found = client.get(f"{NOTIFICATION}/notifications", params={"order_id": "o-1"}).json()
+    assert len(found) == 1
+    assert found[0]["order_id"] == "o-1"
+    assert found[0]["recipient"] == "ann@example.com"
+    assert found[0]["message"] == "Order o-1 confirmed"
+    assert found[0]["created_at"]
+    assert len(client.get(f"{NOTIFICATION}/notifications").json()) == 2
+
+
+def test_same_order_is_stored_once(client):
+    assert send(client, "o-1").status_code == 201
+    again = send(client, "o-1", message="different")
+    assert again.status_code == 200
+    assert again.json()["replayed"] is True
+    assert len(client.get(f"{NOTIFICATION}/notifications", params={"order_id": "o-1"}).json()) == 1
+
+
+def test_unknown_order_returns_empty_list(client):
+    assert client.get(f"{NOTIFICATION}/notifications", params={"order_id": "nope"}).json() == []
+
+
+@pytest.mark.parametrize("recipient", ["", "nope", "a@b"])
+def test_invalid_recipient_rejected(client, recipient):
+    assert send(client, recipient=recipient).status_code == 422
+
+
+def test_health(client):
+    assert client.get(f"{NOTIFICATION}/health").json() == {"status": "ok"}
