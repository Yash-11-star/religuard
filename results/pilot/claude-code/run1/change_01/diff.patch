+"""Notification service.
+
+Stores every notification it is asked to send (order id, recipient, message, created time). It does
+not send real email yet. POST /notifications is idempotent per order_id, so Order can retry safely.
+"""
+import os
+from contextlib import asynccontextmanager
+
+import asyncpg
+from fastapi import FastAPI
+from fastapi.responses import JSONResponse
+from pydantic import BaseModel, Field
+
+DATABASE_URL = os.environ.get("DATABASE_URL", "postgresql://religuard:religuard@postgres:5432/notifications")
+
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS notifications (
+    id         BIGSERIAL PRIMARY KEY,
+    order_id   TEXT NOT NULL UNIQUE,
+    recipient  TEXT NOT NULL,
+    message    TEXT NOT NULL,
+    created_at TIMESTAMPTZ NOT NULL DEFAULT now()
+);
+"""
+
+
+@asynccontextmanager
+async def lifespan(app: FastAPI):
+    app.state.pool = await asyncpg.create_pool(DATABASE_URL, min_size=1, max_size=10, command_timeout=5)
+    async with app.state.pool.acquire() as con:
+        await con.execute(SCHEMA)
+    yield
+    await app.state.pool.close()
+
+
+app = FastAPI(title="notification", lifespan=lifespan)
+
+
+class NotificationRequest(BaseModel):
+    order_id: str = Field(min_length=1)
+    recipient: str = Field(pattern=r"^[^@\s]+@[^@\s]+\.[^@\s]+$", max_length=320)
+    message: str = Field(min_length=1)
+
+
+def body(row, replayed: bool | None = None) -> dict:
+    out = {
+        "id": row["id"],
+        "order_id": row["order_id"],
+        "recipient": row["recipient"],
+        "message": row["message"],
+        "created_at": row["created_at"].isoformat(),
+    }
+    if replayed is not None:
+        out["replayed"] = replayed
+    return out
+
+
+@app.post("/notifications")
+async def create(req: NotificationRequest):
+    async with app.state.pool.acquire() as con:
+        row = await con.fetchrow(
+            """INSERT INTO notifications (order_id, recipient, message) VALUES ($1, $2, $3)
+               ON CONFLICT (order_id) DO NOTHING RETURNING *""",
+            req.order_id, req.recipient, req.message,
+        )
+        if row is not None:
+            return JSONResponse(body(row, replayed=False), status_code=201)
+        row = await con.fetchrow("SELECT * FROM notifications WHERE order_id = $1", req.order_id)
+    return body(row, replayed=True)
+
+
+@app.get("/notifications")
+async def list_notifications(order_id: str | None = None):
+    async with app.state.pool.acquire() as con:
+        rows = await con.fetch(
+            "SELECT * FROM notifications WHERE $1::text IS NULL OR order_id = $1 ORDER BY id", order_id
+        )
+    return [body(r) for r in rows]
+
+
+@app.get("/health")
+async def health():
+    async with app.state.pool.acquire() as con:
+        await con.fetchval("SELECT 1")
+    return {"status": "ok"}
+
+
+@app.post("/admin/reset")
+async def reset():
+    async with app.state.pool.acquire() as con:
+        await con.execute("TRUNCATE notifications RESTART IDENTITY")
+    return {"status": "reset"}
