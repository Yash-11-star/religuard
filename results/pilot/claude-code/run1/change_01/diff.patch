+def notifications(client, order_id, wait=0.0):
+    """Notifications are sent in the background after the order is confirmed, so poll up to `wait` seconds."""
+    deadline = time.monotonic() + wait
+    while True:
+        found = client.get(f"{NOTIFICATION}/notifications", params={"order_id": order_id}).json()
+        if found or time.monotonic() >= deadline:
+            return found
+        time.sleep(0.1)
+
+
+def test_confirmed_checkout_with_email_sends_notification(client):
+    r = checkout(client, customer_email="ann@example.com")
+    assert r.status_code == 200
+    order_id = r.json()["order_id"]
+    sent = notifications(client, order_id, wait=5)
+    assert len(sent) == 1
+    assert sent[0]["recipient"] == "ann@example.com"
+    assert order_id in sent[0]["message"]
+
+
+def test_checkout_without_email_sends_no_notification(client):
+    order_id = checkout(client).json()["order_id"]
+    time.sleep(0.5)
+    assert notifications(client, order_id) == []
+
+
+def test_failed_checkout_sends_no_notification(client):
